@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Function scope also restores the caller's module path when find_dependency()
# returns early for a missing optional/QUIET package lookup.
function(_mw_streamer_find_dependencies)
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    find_dependency(fmt 12.1.0 EXACT CONFIG)
    if(@BUILD_SHARED@)
        find_dependency(FFmpeg COMPONENTS AVCODEC AVFORMAT AVUTIL AVFILTER)
    else()
        find_dependency(Threads)
        find_dependency(spdlog 1.17.0 EXACT CONFIG)
        find_dependency(OpenSSL)
        find_dependency(SRT)
        find_dependency(FFmpeg COMPONENTS AVCODEC AVFORMAT AVUTIL AVFILTER AVDEVICE SWRESAMPLE)
    endif()
    set(mw_streamer_FOUND TRUE PARENT_SCOPE)
endfunction()

set(mw_streamer_FOUND FALSE)
_mw_streamer_find_dependencies()
if(NOT mw_streamer_FOUND)
    set(mw_streamer_NOT_FOUND_MESSAGE "One or more mw_streamer dependencies could not be found.")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mw_streamerTargets.cmake")
check_required_components(mw_streamer)
