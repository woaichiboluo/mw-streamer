@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_mw_opencv_adapter_is_shared @MW_OPENCV_ADAPTER_PACKAGE_IS_SHARED@)
set(_mw_opencv_adapter_prefix "${PACKAGE_PREFIX_DIR}")
set(_mw_streamer_config_dir
    "${CMAKE_CURRENT_LIST_DIR}/../mw_streamer"
)

find_dependency(mw_streamer 0.1 CONFIG
    PATHS "${_mw_streamer_config_dir}"
    NO_DEFAULT_PATH
)
find_dependency(OpenCV COMPONENTS core cudaarithm)

# A dependency config may overwrite PACKAGE_PREFIX_DIR on older CMake versions.
set(PACKAGE_PREFIX_DIR "${_mw_opencv_adapter_prefix}")

function(_mw_opencv_adapter_find_library output name directory)
    unset(${output} CACHE)
    unset(${output})
    find_library(${output}
        NAMES "${name}"
        PATHS "${PACKAGE_PREFIX_DIR}/${directory}"
        NO_DEFAULT_PATH
    )
    if(NOT ${output})
        message(FATAL_ERROR
            "mw_opencv_adapter package is missing the ${name} library"
        )
    endif()
    set(${output} "${${output}}" PARENT_SCOPE)
endfunction()

if(NOT TARGET mw::opencv_adapter)
    if(_mw_opencv_adapter_is_shared)
        if(WIN32)
            _mw_opencv_adapter_find_library(
                _mw_opencv_adapter_implib
                mw_opencv_adapter
                "@CMAKE_INSTALL_LIBDIR@"
            )
            find_file(_mw_opencv_adapter_location
                NAMES mw_opencv_adapter.dll
                PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@"
                NO_DEFAULT_PATH
            )
            if(NOT _mw_opencv_adapter_location)
                message(FATAL_ERROR
                    "mw_opencv_adapter package is missing mw_opencv_adapter.dll"
                )
            endif()
            add_library(mw::opencv_adapter SHARED IMPORTED)
            set_target_properties(mw::opencv_adapter PROPERTIES
                IMPORTED_IMPLIB "${_mw_opencv_adapter_implib}"
                IMPORTED_LOCATION "${_mw_opencv_adapter_location}"
            )
        else()
            _mw_opencv_adapter_find_library(
                _mw_opencv_adapter_location
                mw_opencv_adapter
                "@CMAKE_INSTALL_LIBDIR@"
            )
            add_library(mw::opencv_adapter SHARED IMPORTED)
            set_target_properties(mw::opencv_adapter PROPERTIES
                IMPORTED_LOCATION "${_mw_opencv_adapter_location}"
            )
        endif()
    else()
        find_dependency(CUDAToolkit)
        _mw_opencv_adapter_find_library(
            _mw_opencv_adapter_location
            mw_opencv_adapter
            "@CMAKE_INSTALL_LIBDIR@"
        )
        add_library(mw::opencv_adapter STATIC IMPORTED)
        set_target_properties(mw::opencv_adapter PROPERTIES
            IMPORTED_LOCATION "${_mw_opencv_adapter_location}"
            INTERFACE_COMPILE_DEFINITIONS MW_OPENCV_ADAPTER_STATIC_LIBRARY
        )
    endif()

    set_target_properties(mw::opencv_adapter PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES
            "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@;${OpenCV_INCLUDE_DIRS}"
        INTERFACE_COMPILE_FEATURES cxx_std_17
        INTERFACE_LINK_LIBRARIES "${OpenCV_LIBS}"
    )

    if(NOT _mw_opencv_adapter_is_shared)
        set_property(TARGET mw::opencv_adapter APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES
                "mw::log;CUDA::cuda_driver;CUDA::cudart;CUDA::nppc;CUDA::nppial;CUDA::nppicc;CUDA::nppidei;CUDA::nppig;CUDA::nppitc;FFmpeg::swscale;FFmpeg::avutil"
        )
    endif()
endif()

unset(_mw_streamer_config_dir)
unset(_mw_opencv_adapter_prefix)
unset(_mw_opencv_adapter_is_shared)

check_required_components(mw_opencv_adapter)
