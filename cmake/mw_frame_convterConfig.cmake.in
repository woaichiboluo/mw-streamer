@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

function(_mw_frame_convter_find_dependencies)
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    find_dependency(mw_streamer @PROJECT_VERSION@ CONFIG)
    find_dependency(OpenCV CONFIG COMPONENTS core)
    if(NOT CUDAToolkit_ROOT AND CUDA_TOOLKIT_ROOT_DIR)
        set(CUDAToolkit_ROOT "${CUDA_TOOLKIT_ROOT_DIR}")
    endif()
    find_dependency(CUDAToolkit)
    if(NOT @BUILD_SHARED@)
        find_dependency(FFmpeg COMPONENTS SWSCALE)
    endif()
    set(mw_frame_convter_FOUND TRUE PARENT_SCOPE)
endfunction()

set(mw_frame_convter_FOUND FALSE)
_mw_frame_convter_find_dependencies()
if(NOT mw_frame_convter_FOUND)
    set(mw_frame_convter_NOT_FOUND_MESSAGE "One or more mw_frame_convter dependencies could not be found.")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mw_frame_convterTargets.cmake")
check_required_components(mw_frame_convter)
